# Try-on proxy URL (deployed Cloudflare Worker — see worker/)
EXPO_PUBLIC_TRYON_PROXY_URL=

# Supabase (used for storing selfies)
# Dashboard → Project Settings → API → URL + anon/public key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Worker bearer token — sent as X-Onme-Token on every worker call.
# Generate with `openssl rand -hex 32` and ALSO set the same value as a
# wrangler secret named ONME_API_TOKEN. Without this, anyone with the worker
# URL can drain your YouCam / OpenAI / Replicate / SerpAPI credits.
EXPO_PUBLIC_ONME_API_TOKEN=

# Sentry DSN for crash reporting. Get one at https://sentry.io.
# Leave blank to disable Sentry init (errors will only log to console).
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In OAuth client IDs.
# Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID.
# Make THREE: iOS (bundle com.onme.app), Android (package com.onme.app + SHA-1),
# Web (used both for the in-app id_token request and to paste into Supabase
# Auth → Providers → Google).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-side secrets (set via wrangler, NOT in this file):
#   cd worker && wrangler secret put PERFECTCORP_API_KEY
#   cd worker && wrangler secret put OPENAI_API_KEY
#   cd worker && wrangler secret put SERPAPI_KEY
#   cd worker && wrangler secret put REPLICATE_API_TOKEN
#   cd worker && wrangler secret put ONME_API_TOKEN  # same value as EXPO_PUBLIC_ONME_API_TOKEN
